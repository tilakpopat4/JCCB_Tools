{
  "version": 2,
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/sql", "destination": "/api/sql.js" },
    { "source": "/merger", "destination": "/merger.html" },
    { "source": "/gold", "destination": "/gold-jccb-final-main/index.html" },
    { "source": "/fd", "destination": "/fd-module/index.html" },
    { "source": "/od", "destination": "/od-module/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, DELETE, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Neon-Connection-String, Authorization" }
      ]
    }
  ]
}
