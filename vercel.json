{
  "version": 2,
  "routes": [
    { "src": "/api/sql", "dest": "/api/sql.js" },
    { "handle": "filesystem" },
    { "src": "/merger", "dest": "/merger.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Neon-Connection-String, Authorization" }
      ]
    }
  ]
}
