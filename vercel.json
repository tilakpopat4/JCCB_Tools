{
  "version": 2,
  "builds": [
    { "src": "api/sql.js", "use": "@vercel/node" },
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "*.js", "use": "@vercel/static" },
    { "src": "*.png", "use": "@vercel/static" },
    { "src": "gold-jccb-final-main/**", "use": "@vercel/static" },
    { "src": "fd-module/**", "use": "@vercel/static" },
    { "src": "od-module/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/sql", "dest": "/api/sql.js" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
