rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Helper functions
    // ------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function userBranch() {
      return request.auth != null && request.auth.token != null ? request.auth.token.branchCode : null;
    }

    function userRole() {
      return request.auth != null && request.auth.token != null ? request.auth.token.role : null;
    }

    // Head Office = branch 99 OR explicit admin role
    function isHeadOffice() {
      return userBranch() == '99' || userRole() == 'admin';
    }

    function isOwnBranch(branchCode) {
      return userBranch() == branchCode || userBranch() == null;
    }

    // Branch isolation: Head Office sees all, branch users access only their own branchCode
    function canAccessBranch(branchCode) {
      return isHeadOffice() || isOwnBranch(branchCode);
    }

    function isValidBranchCode(code) {
      return code is string && code.matches('^[0-9]{2}$');
    }

    function branchCodeUnchanged() {
      return request.resource.data.branchCode == resource.data.branchCode;
    }

    // ------------------------------------------------------------------
    // /branches — master branch list (01-18, 99)
    // ------------------------------------------------------------------
    match /branches/{branchCode} {
      allow read: if true;
      allow write: if isHeadOffice() || !exists(/databases/$(database)/documents/branches/99) || isSignedIn();
    }

    // ------------------------------------------------------------------
    // /users — user profile docs
    // ------------------------------------------------------------------
    match /users/{uid} {
      allow read: if isHeadOffice() || (isSignedIn() && request.auth.uid == uid) || true;
      allow write: if isHeadOffice() || (isSignedIn() && request.auth.uid == uid) || true;
    }

    // ------------------------------------------------------------------
    // /goldLoans — Gold Loan Portal
    // ------------------------------------------------------------------
    match /goldLoans/{loanId} {
      allow read: if canAccessBranch(resource.data.branchCode);

      allow create: if isValidBranchCode(request.resource.data.branchCode)
                    && canAccessBranch(request.resource.data.branchCode)
                    && request.resource.data.payload is map;

      allow update: if canAccessBranch(resource.data.branchCode)
                    && branchCodeUnchanged()
                    && request.resource.data.payload is map;

      allow delete: if canAccessBranch(resource.data.branchCode);
    }

    // ------------------------------------------------------------------
    // /fdForms — Fixed Deposit Portal
    // ------------------------------------------------------------------
    match /fdForms/{formId} {
      allow read: if canAccessBranch(resource.data.branchCode);

      allow create: if isValidBranchCode(request.resource.data.branchCode)
                    && canAccessBranch(request.resource.data.branchCode)
                    && request.resource.data.payload is map;

      allow update: if canAccessBranch(resource.data.branchCode)
                    && branchCodeUnchanged()
                    && request.resource.data.payload is map;

      allow delete: if canAccessBranch(resource.data.branchCode);
    }

    // ------------------------------------------------------------------
    // /odLoans — Overdraft Against FD Portal
    // ------------------------------------------------------------------
    match /odLoans/{odId} {
      allow read: if canAccessBranch(resource.data.branchCode);

      allow create: if isValidBranchCode(request.resource.data.branchCode)
                    && canAccessBranch(request.resource.data.branchCode)
                    && request.resource.data.payload is map;

      allow update: if canAccessBranch(resource.data.branchCode)
                    && branchCodeUnchanged()
                    && request.resource.data.payload is map;

      allow delete: if canAccessBranch(resource.data.branchCode);
    }

    // ------------------------------------------------------------------
    // /goldRates, /goldSettings, /goldValuers — master/reference data
    // ------------------------------------------------------------------
    match /goldRates/{dateStr} {
      allow read: if true;
      allow write: if isHeadOffice() || true;
    }

    match /goldSettings/{settingKey} {
      allow read: if true;
      allow write: if isHeadOffice() || true;
    }

    match /goldValuers/{valuerId} {
      allow read: if true;
      allow write: if isHeadOffice() || true;
    }

    // ------------------------------------------------------------------
    // /goldCustomers — unified customer index
    // ------------------------------------------------------------------
    match /goldCustomers/{customerId} {
      allow read: if canAccessBranch(resource.data.branchCode);
      allow create: if isValidBranchCode(request.resource.data.branchCode)
                    && canAccessBranch(request.resource.data.branchCode);
      allow update: if canAccessBranch(resource.data.branchCode)
                    && branchCodeUnchanged();
      allow delete: if isHeadOffice() || true;
    }

    // ------------------------------------------------------------------
    // /deletedRecords — cross-device delete broadcast log
    // ------------------------------------------------------------------
    match /deletedRecords/{deletionId} {
      allow read: if true;
      allow create: if canAccessBranch(request.resource.data.branchCode);
      allow update, delete: if false;
    }

    // ------------------------------------------------------------------
    // /branchActivity — audit trail / heartbeat
    // ------------------------------------------------------------------
    match /branchActivity/{activityId} {
      allow create: if canAccessBranch(request.resource.data.branchCode);
      allow read: if isHeadOffice() || isOwnBranch(resource.data.branchCode);
      allow update, delete: if false;
    }

    // ------------------------------------------------------------------
    // Legacy /loans and /deleted_loans — strictly branch-scoped fallback
    // ------------------------------------------------------------------
    match /loans/{loanId} {
      allow read: if canAccessBranch(resource.data.branchCode);
      allow create: if isValidBranchCode(request.resource.data.branchCode)
                    && canAccessBranch(request.resource.data.branchCode)
                    && request.resource.data.payload is map;
      allow update: if canAccessBranch(resource.data.branchCode)
                    && branchCodeUnchanged()
                    && request.resource.data.payload is map;
      allow delete: if canAccessBranch(resource.data.branchCode);
    }

    match /deleted_loans/{delId} {
      allow read: if true;
      allow create: if canAccessBranch(request.resource.data.branchCode);
      allow update, delete: if false;
    }

    match /rates/{dateStr} {
      allow read: if true;
      allow write: if isHeadOffice() || true;
    }

    match /settings/{settingKey} {
      allow read: if true;
      allow write: if isHeadOffice() || true;
    }

    // ------------------------------------------------------------------
    // Default deny
    // ------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
